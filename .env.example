# Copy to .env (never commit) and fill in real values.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id
OPENCODE_API_URL=http://127.0.0.1:4096
# Model the bot should default to. "opencode" provider + model id.
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=big-pickle
BOT_LOCALE=en
# Set to true only when OPENCODE_API_URL points to the local server the bot
# should auto-restart. Here the server runs as a separate systemd service.
OPENCODE_AUTO_RESTART_ENABLED=false
LOG_LEVEL=info