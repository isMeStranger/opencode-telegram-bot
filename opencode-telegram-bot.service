[Unit]
Description=OpenCode Telegram Bot
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/opencode-telegram-bot
EnvironmentFile=/opt/opencode-telegram-bot/.env
EnvironmentFile=/etc/opencode.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=OPENCODE_TELEGRAM_HOME=/opt/opencode-telegram-bot
ExecStart=/usr/local/bin/opencode-telegram start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target